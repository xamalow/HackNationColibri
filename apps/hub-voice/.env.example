# Copy to .env (gitignored) on the hub PC. Every value is a LOCAL server or a LiveKit credential.
# Nothing here is ever committed, posted in the room or written to a log.

# LiveKit (self-hosted on the hub PC; LiveKit Cloud is not needed)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound alert calls to Noor (worker "sauti-alert", python -m hub_voice.outbound). The ONLY number it ever dials.
SAUTI_OWNER_E164=          # Noor's enrolled basic phone, E.164; empty = simulated (calls are planned and logged, never placed)
SAUTI_OWNER_DEVICE_ID=     # the opaque device id the hub uses for that phone; alerts for any other device are refused
LIVEKIT_SIP_TRUNK_ID=      # the LiveKit OUTBOUND SIP trunk (Carter's Twilio setup); empty = simulated
SAUTI_ALERT_DAILY_CAP=20   # calls per farm day (Africa/Nairobi), counted before any dispatch

# Local model servers, OpenAI-compatible. Leave empty = simulated (the worker will not speak; use `simulate`).
SAUTI_STT_BASE_URL=        # faster-whisper server, e.g. http://127.0.0.1:8001/v1
SAUTI_STT_MODEL=whisper-1
SAUTI_LLM_BASE_URL=        # llama.cpp / Ollama serving Gemma 4 E4B, e.g. http://127.0.0.1:8080/v1
                           # start llama-server with --reasoning off (or --reasoning-budget 0); Gemma 4 otherwise thinks and answers nothing
SAUTI_LLM_MODEL=gemma-4-e4b-it
SAUTI_TTS_BASE_URL=        # Chatterbox wrapper; it must accept model "tts-1" and return wav/pcm 24 kHz
SAUTI_TTS_VOICE=sauti

# The hub (apps/hub). Leave empty = simulated against fixtures/ and runtime/proposals.jsonl.
SAUTI_HUB_BASE_URL=        # e.g. http://127.0.0.1:8787
HUB_TOKEN=                 # bearer token for the hub, read at call time

SAUTI_AGENT_NAME=sauti-hub
SAUTI_SIDECAR_BUDGET_MS=1500
SAUTI_TENANT_ID=demo-farm-001

# Voice demo without telephony (RUNBOOK.md): the browser page may choose owner MODE for a demo room. Grants nothing.
# Set to 1 only on the demo PC; leave unset for real calls (the enrolled caller id decides, metadata is ignored).
SAUTI_DEMO_ALLOW_METADATA_MODE=
