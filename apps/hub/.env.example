# Template for the hub's PRIVATE env file (apps/hub/src/run_hub.mjs). Variable NAMES only, never values in git.
# Copy it OUTSIDE any git working tree (e.g. %USERPROFILE%\sauti\hub.env or ~/.config/sauti/hub.env), fill it there,
# and point HUB_ENV_FILE at it. The runner refuses an env file inside a repository.
# Explicit environment variables win over the file.

# Required for --live
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
HUB_OWNER_PHONE=
HUB_DB_PATH=

# Optional
HUB_CLIP_BASE_URL=
HUB_POLL_SECONDS=
HUB_FARM_SHEET=
HUB_MAX_OUTBOUND_PER_DAY=
HUB_BACKLOG_MINUTES=
HUB_VERBOSE=
TWILIO_STATUS_CALLBACK_URL=

# Dry-run only (no network)
HUB_DRY_RUN=
HUB_DRY_RUN_INBOUND=
HUB_DRY_RUN_OUTBOUND=
