# Template for the hub's PRIVATE env file (apps/hub/src/run_hub.mjs). Variable NAMES only, never values in git.
# Copy it OUTSIDE any git working tree (e.g. %USERPROFILE%\sauti\hub.env or ~/.config/sauti/hub.env), fill it there,
# and point HUB_ENV_FILE at it. The runner refuses an env file inside a repository.
# Explicit environment variables win over the file.

# Required for --live. Auth = a Twilio API key (Basic KEY_SID:KEY_SECRET); the account SID stays in the URLs.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_NUMBER=
OWNER_PHONE=
HUB_DB_PATH=

# Optional
# TWILIO_AUTH_TOKEN: fallback REST auth only when no API key is set (later: webhook signatures). Leave empty with a key.
TWILIO_AUTH_TOKEN=
HUB_CLIP_BASE_URL=
HUB_POLL_SECONDS=
HUB_FARM_SHEET=
HUB_MAX_OUTBOUND_PER_DAY=
HUB_BACKLOG_MINUTES=
HUB_VERBOSE=
TWILIO_STATUS_CALLBACK_URL=

# Dry-run only (no network)
HUB_DRY_RUN=
HUB_DRY_RUN_INBOUND=
HUB_DRY_RUN_OUTBOUND=

# Old names still accepted as aliases (prefer the names above): TWILIO_FROM_NUMBER, HUB_OWNER_PHONE
